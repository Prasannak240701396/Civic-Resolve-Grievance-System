		batchworkflow
		{
			Central_Complaint_Intelli
			{
    			display name = "Central_Complaint_Intelligence_Engine"
    			type = batchworkflow
    			form = complaint
    			event = "On Schedule"
    			start = "08-Nov-2026 14:20:00"
    			frequency = daily
    			batch size = 1000
    			status = active
    			on execute 
    			{
					actions 
					{
						custom deluge script
						(
											activeComplaints = complaint[status != "Closed" && status != "Resolved"];
										processedCount = 0;
										overdueCount = 0;
										upcomingCount = 0;
										unassignedCount = 0;
										reportDate = zoho.currentdate.toString("yyyy-MM-dd");
										for each  rec in activeComplaints
										{
											riskLevel = "Normal";
											issueDetails = "";
											// Check SLA deadline
											if(rec.sla_due_date == null)
											{
												riskLevel = "SLA Not Configured";
												issueDetails = "SLA due date is missing";
											}
											else if(rec.sla_due_date <= zoho.currenttime)
											{
												riskLevel = "SLA Breached";
												overdueCount = overdueCount + 1;
												overdueDays = rec.sla_due_date.toDate().daysBetween(zoho.currentdate);
												issueDetails = "SLA overdue by " + overdueDays + " day(s)";
											}
											else if(rec.sla_due_date <= zoho.currenttime.addDay(2))
											{
												riskLevel = "SLA At Risk";
												upcomingCount = upcomingCount + 1;
												issueDetails = "SLA deadline approaching within 48 hours";
											}
											// Check officer assignment
											if(rec.assigned_officer == null)
											{
												unassignedCount = unassignedCount + 1;
												if(issueDetails != "")
												{
													issueDetails = issueDetails + "; ";
												}
												issueDetails = issueDetails + "Officer assignment missing";
											}
											// Build daily analysis log
											analysisAction = "Central Intelligence Analysis - " + reportDate;
											existingLog = complaint_activity_log[complaint == rec.ID && action_performed == analysisAction];
											if(existingLog.count() == 0)
											{
												if(issueDetails == "")
												{
													issueDetails = "No immediate SLA or assignment issue detected";
												}
												insert into complaint_activity_log
												[
													complaint=rec.ID
													previous_status=rec.status
													new_status=rec.status
													action_performed=analysisAction + " | Risk: " + riskLevel + " | Priority: " + rec.priority + " | " + issueDetails
													changed_by=zoho.loginuser
													activity_date_time=zoho.currenttime
													Added_User=zoho.loginuser
												]
												processedCount = processedCount + 1;
											}
										}
										// Final processing summary
										info "================================";
										info "CIVIC RESOLVE";
										info "CENTRAL INTELLIGENCE ENGINE";
										info "================================";
										info "Analysis Date: " + reportDate;
										info "Complaints Analyzed: " + processedCount;
										info "SLA Breached: " + overdueCount;
										info "SLA At Risk: " + upcomingCount;
										info "Unassigned Complaints: " + unassignedCount;
										info "================================";
										info "Analysis Completed Successfully";
						)
					}
    			}
			}
			Duplicate_Complaint_Detec
			{
    			display name = "Duplicate_Complaint_Detection_Engine"
    			type = batchworkflow
    			form = complaint
    			event = "On Schedule"
    			start = "08-Nov-2026 16:00:00"
    			frequency = daily
    			batch size = 1000
    			status = active
    			on execute 
    			{
					actions 
					{
						custom deluge script
						(
											allComplaints = complaint[complaint_title != null];
										duplicateCount = 0;
										newFlags = 0;
										for each  rec in allComplaints
										{
											matchingComplaints = complaint[complaint_title == rec.complaint_title];
											for each  matchRec in matchingComplaints
											{
												// Compare each pair only once
												if(matchRec.ID < rec.ID && matchRec.citizen == rec.citizen)
												{
													duplicateCount = duplicateCount + 1;
													duplicateAction = "Possible Duplicate Complaint - Matching Record ID: " + matchRec.ID;
													existingLog = complaint_activity_log[complaint == rec.ID && action_performed == duplicateAction];
													if(existingLog.count() == 0)
													{
														insert into complaint_activity_log
														[
															complaint=rec.ID
															previous_status=rec.status
															new_status=rec.status
															action_performed=duplicateAction
															changed_by=zoho.loginuser
															activity_date_time=zoho.currenttime
															Added_User=zoho.loginuser
														]
														newFlags = newFlags + 1;
													}
												}
											}
										}
										info "================================";
										info "CIVIC RESOLVE";
										info "DUPLICATE DETECTION REPORT";
										info "================================";
										info "Total Complaints Scanned: " + allComplaints.count();
										info "Possible Duplicate Pairs: " + duplicateCount;
										info "New Duplicate Flags Created: " + newFlags;
										info "================================";
										info "Duplicate Detection Completed";
						)
					}
    			}
			}
			Department_Performance_Op
			{
    			display name = "Department_Performance_Optimizer"
    			type = batchworkflow
    			form = complaint
    			event = "On Schedule"
    			start = "08-Nov-2026 15:00:00"
    			frequency = daily
    			batch size = 1000
    			status = active
    			on execute 
    			{
					actions 
					{
						custom deluge script
						(
											allDepartments = department[ID != 0];
										allComplaints = complaint[ID != 0];
										departmentCount = 0;
										totalAnalyzed = 0;
										report = "========================================\n";
										report = report + "          CIVIC RESOLVE\n";
										report = report + "   DEPARTMENT PERFORMANCE REPORT\n";
										report = report + "========================================\n\n";
										for each  dept in allDepartments
										{
											totalCases = 0;
											activeCases = 0;
											resolvedCases = 0;
											closedCases = 0;
											overdueCases = 0;
											unassignedCases = 0;
											for each  rec in allComplaints
											{
												if(rec.department == dept.ID)
												{
													totalCases = totalCases + 1;
													if(rec.status == "Resolved")
													{
														resolvedCases = resolvedCases + 1;
													}
													else if(rec.status == "Closed")
													{
														closedCases = closedCases + 1;
													}
													else
													{
														activeCases = activeCases + 1;
														if(rec.assigned_officer == null)
														{
															unassignedCases = unassignedCases + 1;
														}
														if(rec.sla_due_date != null && rec.sla_due_date <= zoho.currenttime)
														{
															overdueCases = overdueCases + 1;
														}
													}
												}
											}
											if(totalCases > 0)
											{
												departmentCount = departmentCount + 1;
												totalAnalyzed = totalAnalyzed + totalCases;
												completedCases = resolvedCases + closedCases;
												completionRate = (completedCases * 100.0) / totalCases;
												report = report + "----------------------------------------\n" + "DEPARTMENT: " + dept.department_name + "\n" + "----------------------------------------\n" + "Total Complaints       : " + totalCases + "\n" + "Active Complaints      : " + activeCases + "\n" + "Resolved Complaints    : " + resolvedCases + "\n" + "Closed Complaints      : " + closedCases + "\n" + "Overdue Complaints     : " + overdueCases + "\n" + "Unassigned Complaints  : " + unassignedCases + "\n" + "Completion Rate        : " + completionRate + "%\n\n";
											}
										}
										report = report + "========================================\n" + "FINAL PERFORMANCE SUMMARY\n" + "========================================\n" + "Departments Analyzed : " + departmentCount + "\n" + "Total Complaints     : " + totalAnalyzed + "\n" + "Report Date          : " + zoho.currentdate + "\n" + "========================================\n" + "Generated by Civic Resolve System";
										info report;
						)
					}
    			}
			}
		}

	}
