	reports
	{
		list complaint_activity_log_Report
		{
			displayName = "Complaint Activity Log Report"
			show all rows from complaint_activity_log    
			(
				complaint as "Complaint"
				previous_status as "Previous Status"
				new_status as "New Status"
				action_performed as "Action Performed"
				remarks as "Remarks"
