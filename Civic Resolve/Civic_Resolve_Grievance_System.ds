				new_officer as "New Officer"
				previous_department as "Previous Department"
				new_department as "New Department"
			)
		}
		list complaint_Report
		{
			displayName = "All Complaints"
			show all rows from complaint    
			(
				complaint_title as "Complaint Title"
				complaint_description as "Complaint Description"
				category as "Category"
				priority as "Priority"
				location as "Location"
				city as "City"
				submission_date_time as "Submission Date and Time"
				department as "Department"
				assigned_officer as "Assigned Officer"
				status as "Status"
				sla_due_date as "SLA Due Date"
				resolution_description as "Resolution Description"
				resolution_date as "Resolution Date"
				citizen_satisfaction_rating as "Citizen Satisfaction Rating"
				citizen_feedback as "Citizen Feedback"
				last_updated as "Last Updated"
				citizen as "Citizen"
				ID
			)
			conditional formatting
			(
				"New Formatting1"
				{
				condition = (priority == "Critical")
				fields = [priority]
				format = "color:#ffffff;background-color:#765f89;"
				}
				"New Formatting2"
				{
				condition = (priority == "High")
				fields = [priority]
				format = "color:#000000;background-color:#1bbc9b;"
				}
				"New Formatting3"
				{
				condition = (priority == "Medium")
				fields = [priority]
				format = "color:#ffffff;background-color:#e84c3d;"
				}
			)
		}
		kanban complaint_by_category
		{
			displayName = "Categories"
