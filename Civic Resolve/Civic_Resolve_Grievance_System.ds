					}
				}

			}
			Create_CRM_Contact as "Create_CRM_Contact"
			{
				type =  form
				form = citizen

				record event = on add

				on success
				{
					actions 
					{
						custom deluge script
						(
											contactMap = Map();
										contactMap.put("Last_Name",input.citizen_name);
										contactMap.put("Email",input.email);
										contactMap.put("Phone",input.mobile_number);
										contactMap.put("Mobile",input.mobile_number);
										contactMap.put("Mailing_Street",input.address);
										contactMap.put("Mailing_Zip",input.postal_code1);
										response = zoho.crm.createRecord("Contacts",contactMap);
										if(response.get("id") != null)
										{
											crmID = response.get("id").toString();
											update citizen[ID == input.ID]
											[
												crm_contact_id=crmID
											];
											info "CRM Contact created successfully. ID: " + crmID;
										}
										else
										{
											info "CRM Contact creation failed: " + response;
										}
						)
					}
				}

			}
			Create_CRM_Case as "Create_CRM_Case"
			{
				type =  form
				form = complaint

				record event = on add

				on success
				{
					actions 
					{
						custom deluge script
						(
											caseMap = Map();
										caseMap.put("Subject",input.complaint_title);
										caseMap.put("Description",input.complaint_description);
										citizenRecord = citizen[ID == input.citizen];
										if(citizenRecord.crm_contact_id != null && citizenRecord.crm_contact_id != "")
										{
											caseMap.put("Contact_Name",{"id":citizenRecord.crm_contact_id});
											info "CRM Contact ID: " + citizenRecord.crm_contact_id;
											info "Case Map: " + caseMap;
											response = zoho.crm.createRecord("Cases",caseMap);
											if(response.get("id") != null)
											{
												crmID = response.get("id").toString();
												update complaint[ID == input.ID]
												[
													crm_case_id1=crmID
												];
												info "CRM Case created successfully. ID: " + crmID;
											}
											else
											{
												info "CRM Case creation failed: " + response;
											}
										}
										else
										{
											info "CRM Contact ID not found. Cannot link this Case.";
										}
						)
					}
				}

			}
		}

		schedule
		{
			SLA_Escalation_with_Email as "SLA Escalation with Email"
			{
				type =  schedule
				start = "2026-11-08 15:00:00"
				frequency = daily
				time zone = "Asia/Kolkata"
				on start
				{
					actions 
					{
					on load
					(
						// Get all active complaints
										allComplaints = complaint[sla_due_date != null && status != "Closed" && status != "Resolved"];
										for each  rec in allComplaints
										{
											if(rec.assigned_officer != null)
											{
												officerRec = officer[ID == rec.assigned_officer];
												if(officerRec.count() > 0 && officerRec.email != null && officerRec.email != "")
												{
													// CASE 1: SLA deadline approaching within 24 hours
													if(rec.sla_due_date > zoho.currenttime && rec.sla_due_date <= zoho.currenttime.addDay(1))
													{
														warningLog = complaint_activity_log[complaint == rec.ID && action_performed == "SLA Warning Email Sent"];
														if(warningLog.count() == 0)
														{
															sendmail
															[
																from :zoho.adminuserid
																to :officerRec.email
																subject :"SLA Warning: Complaint Due Soon"
																message :"Dear Officer,<br><br>The SLA deadline for this complaint is approaching.<br><br><b>Complaint:</b> " + rec.complaint_title + "<br><b>SLA Due Date:</b> " + rec.sla_due_date + "<br><b>Priority:</b> " + rec.priority + "<br><b>Status:</b> " + rec.status + "<br><br>Please take action before the deadline.<br><br>Civic Resolve System"
															]
															insert into complaint_activity_log
															[
																complaint=rec.ID
																previous_status=rec.status
																new_status=rec.status
																action_performed="SLA Warning Email Sent"
																changed_by=zoho.loginuser
																activity_date_time=zoho.currenttime
																Added_User=zoho.loginuser
															]
														}
													}
													// CASE 2: SLA deadline has passed
													else if(rec.sla_due_date <= zoho.currenttime && rec.priority != "Critical")
													{
														oldPriority = rec.priority;
														update complaint[ID == rec.ID]
														[
															priority="Critical"
														];
														insert into complaint_activity_log
														[
															complaint=rec.ID
															previous_status=rec.status
															new_status=rec.status
															action_performed="SLA Breach - Priority escalated from " + oldPriority + " to Critical"
															changed_by=zoho.loginuser
															activity_date_time=zoho.currenttime
															Added_User=zoho.loginuser
														]
														sendmail
														[
															from :zoho.adminuserid
															to :officerRec.email
															subject :"URGENT: SLA Breached - Critical Complaint"
															message :"Dear Officer,<br><br>The SLA deadline for this complaint has been breached. Its priority has automatically been escalated to CRITICAL.<br><br><b>Complaint:</b> " + rec.complaint_title + "<br><b>Previous Priority:</b> " + oldPriority + "<br><b>New Priority:</b> Critical<br><b>SLA Due Date:</b> " + rec.sla_due_date + "<br><b>Status:</b> " + rec.status + "<br><br>Please take immediate action.<br><br>Civic Resolve System"
														]
													}
												}
											}
										}
					)
					}
				}
			}
			Auto_Close_Resolved_Compl as "Auto_Close_Resolved_Complaints"
			{
				type =  schedule
				start = "2026-11-08 15:20:00"
				frequency = daily
				time zone = "Asia/Kolkata"
				on start
				{
					actions 
					{
					on load
					(
						resolvedComplaints = complaint[status == "Resolved" && resolution_date != null && resolution_date <= zoho.currenttime.addDay(-7)];
										for each  rec in resolvedComplaints
										{
											update complaint[ID == rec.ID]
											[
												status="Closed"
											];
											insert into complaint_activity_log
											[
												complaint=rec.ID
												previous_status="Resolved"
												new_status="Closed"
												action_performed="Automatically Closed After 7 Days of Resolution"
												changed_by=zoho.loginuser
												activity_date_time=zoho.currenttime
												Added_User=zoho.loginuser
											]
											if(rec.citizen != null)
											{
												citizenRec = citizen[ID == rec.citizen];
												if(citizenRec.count() > 0 && citizenRec.email != null && citizenRec.email != "")
												{
													sendmail
													[
														from :zoho.adminuserid
														to :citizenRec.email
														subject :"Your Civic Complaint Has Been Closed"
														message :"Dear Citizen,<br><br>Your complaint has remained in Resolved status for 7 days and has now been automatically marked as Closed.<br><br><b>Complaint:</b> " + rec.complaint_title + "<br><b>Previous Status:</b> Resolved<br><b>Current Status:</b> Closed<br><br>Thank you for using Civic Resolve. If the issue is still unresolved, please contact the concerned department.<br><br>Regards,<br>Civic Resolve Team"
													]
												}
											}
										}
					)
					}
				}
			}
			Daily_Executive_Grievance as "Daily_Executive_Grievance_Digest"
			{
				type =  schedule
				start = "2026-11-08 15:40:00"
				frequency = daily
				time zone = "Asia/Kolkata"
				on start
				{
					actions 
					{
					on load
					(
						todayDate = zoho.currentdate.toString("yyyy-MM-dd");
										// Complaint statistics
										totalComplaints = 0;
										pendingCount = 0;
										inProgressCount = 0;
										resolvedCount = 0;
										closedCount = 0;
										allComplaints = complaint[submission_date_time != null];
										for each  rec in allComplaints
										{
											if(rec.submission_date_time.toString("yyyy-MM-dd") == todayDate)
											{
												totalComplaints = totalComplaints + 1;
												if(rec.status == "Pending")
												{
													pendingCount = pendingCount + 1;
												}
												else if(rec.status == "In Progress")
												{
													inProgressCount = inProgressCount + 1;
												}
												else if(rec.status == "Resolved")
												{
													resolvedCount = resolvedCount + 1;
												}
												else if(rec.status == "Closed")
												{
													closedCount = closedCount + 1;
												}
											}
										}
										// Citizen feedback statistics
										totalFeedback = 0;
										ratingTotal = 0;
										averageRating = 0;
										allFeedback = citizen_feedback[submitted_date != null];
										for each  feedbackRec in allFeedback
										{
											if(feedbackRec.submitted_date.toString("yyyy-MM-dd") == todayDate)
											{
												totalFeedback = totalFeedback + 1;
												if(feedbackRec.rating != null)
												{
													ratingTotal = ratingTotal + feedbackRec.rating;
												}
											}
										}
										if(totalFeedback > 0)
										{
											averageRating = ratingTotal / totalFeedback;
										}
										// Prepare daily executive email
										emailMessage = "<h2>Daily Civic Resolve Executive Report</h2>";
										emailMessage = emailMessage + "<b>Date:</b> " + todayDate + "<br><br>";
										emailMessage = emailMessage + "<h3>Complaint Summary</h3>";
										emailMessage = emailMessage + "Total Complaints Today: " + totalComplaints + "<br>";
										emailMessage = emailMessage + "Pending: " + pendingCount + "<br>";
										emailMessage = emailMessage + "In Progress: " + inProgressCount + "<br>";
										emailMessage = emailMessage + "Resolved: " + resolvedCount + "<br>";
										emailMessage = emailMessage + "Closed: " + closedCount + "<br><br>";
										emailMessage = emailMessage + "<h3>Citizen Feedback Summary</h3>";
										emailMessage = emailMessage + "Total Feedback Today: " + totalFeedback + "<br>";
										emailMessage = emailMessage + "Average Rating: " + averageRating + " / 5<br><br>";
										emailMessage = emailMessage + "Regards,<br>Civic Resolve System";
										// Send daily report
										sendmail
										[
											from :zoho.adminuserid
											to :"prasanna.k.2024.cse@rajalakshmi.edu.in"
											subject :"Daily Civic Resolve Executive Report"
											message :emailMessage
										]
					)
					}
				}
			}
			Executive_Intelligence_Da as "Executive_Intelligence_Dashboard"
			{
				type =  schedule
				start = "2026-11-08 17:35:00"
				frequency = daily
				time zone = "Asia/Kolkata"
				on start
				{
					actions 
					{
					on load
					(
						allComplaints = complaint[ID != 0];
										allDepartments = department[ID != 0];
										allActivityLogs = complaint_activity_log[ID != 0];
										totalComplaints = allComplaints.count();
										activeComplaints = 0;
										resolvedComplaints = 0;
										closedComplaints = 0;
										overdueComplaints = 0;
										atRiskComplaints = 0;
										unassignedComplaints = 0;
										duplicateFlags = 0;
										departmentCount = 0;
										todayDate = zoho.currentdate;
										riskLimit = todayDate.addDay(2);
										for each  rec in allComplaints
										{
											if(rec.status == "Resolved")
											{
												resolvedComplaints = resolvedComplaints + 1;
											}
											else if(rec.status == "Closed")
											{
												closedComplaints = closedComplaints + 1;
											}
											else
											{
												activeComplaints = activeComplaints + 1;
												if(rec.assigned_officer == null)
												{
													unassignedComplaints = unassignedComplaints + 1;
												}
												if(rec.sla_due_date != null)
												{
													dueDate = rec.sla_due_date.toDate();
													if(dueDate < todayDate)
													{
														overdueComplaints = overdueComplaints + 1;
													}
													else if(dueDate <= riskLimit)
													{
														atRiskComplaints = atRiskComplaints + 1;
													}
												}
											}
										}
										// Duplicate detection summary
										for each  logRec in allActivityLogs
										{
											if(logRec.action_performed != null && logRec.action_performed.contains("Possible Duplicate Complaint"))
											{
												duplicateFlags = duplicateFlags + 1;
											}
										}
										// Department performance analysis
										departmentReport = "";
										for each  dept in allDepartments
										{
											deptTotal = 0;
											deptResolved = 0;
											deptClosed = 0;
											deptActive = 0;
											deptOverdue = 0;
											for each  rec in allComplaints
											{
												if(rec.department == dept.ID)
												{
													deptTotal = deptTotal + 1;
													if(rec.status == "Resolved")
													{
														deptResolved = deptResolved + 1;
													}
													else if(rec.status == "Closed")
													{
														deptClosed = deptClosed + 1;
													}
													else
													{
														deptActive = deptActive + 1;
														if(rec.sla_due_date != null && rec.sla_due_date.toDate() < todayDate)
														{
															deptOverdue = deptOverdue + 1;
														}
													}
												}
											}
											if(deptTotal > 0)
											{
												departmentCount = departmentCount + 1;
												completionRate = ((deptResolved + deptClosed) * 100.0) / deptTotal;
												departmentReport = departmentReport + "\nDepartment: " + dept.department_name + "\nTotal: " + deptTotal + " | Active: " + deptActive + " | Resolved: " + deptResolved + " | Closed: " + deptClosed + " | Overdue: " + deptOverdue + "\nCompletion Rate: " + completionRate + "%" + "\n--------------------------------";
											}
										}
										// Generate executive report
										executiveReport = "\n================================" + "\nCIVIC RESOLVE" + "\nEXECUTIVE INTELLIGENCE DASHBOARD" + "\n================================" + "\nReport Date: " + todayDate + "\n\nOVERALL COMPLAINT SUMMARY" + "\nTotal Complaints: " + totalComplaints + "\nActive Complaints: " + activeComplaints + "\nResolved Complaints: " + resolvedComplaints + "\nClosed Complaints: " + closedComplaints + "\n\nSLA PERFORMANCE" + "\nSLA Breached: " + overdueComplaints + "\nSLA At Risk (Next 2 Days): " + atRiskComplaints + "\nUnassigned Complaints: " + unassignedComplaints + "\n\nDUPLICATE DETECTION" + "\nExisting Duplicate Flags: " + duplicateFlags + "\n\nDEPARTMENT PERFORMANCE" + "\nDepartments Analyzed: " + departmentCount + "\n" + departmentReport + "\n================================" + "\nEXECUTIVE ANALYSIS COMPLETED" + "\n================================";
										// Send executive report by email
										sendmail
										[
											from :zoho.adminuserid
											to :zoho.adminuserid
											subject :"Civic Resolve - Daily Executive Intelligence Report"
											message :executiveReport
										]
										info "Executive Intelligence Report generated and email sent to administrator.";
										info executiveReport;
					)
					}
				}
			}
		}

		approval
		{
			Civic_Resolve_Smart_Appro as "Civic_Resolve_Smart_Approval"
			{
				type =  approval
				form = closure_review[review_status == "Pending"]
				display fields = [complaint_selection,requested_by,review_reason,review_description,evidence_attachment,review_status,assigned_reviewer]
				on start
				{
				}
				on level 1
				{
					approvers
					(
			 			role = "Department Head"
					)
					on approve 
					{
						actions 
						{
							sendmail
							(
								from : zoho.loginuserid
								to : approver.submitter
								subject : "Approval Request"
								message : "Your request has been approved."
							)
						}
					}
					on reject
					{

						actions 
						{
							sendmail
							(
								from : zoho.loginuserid
								to : approver.submitter
								subject : "Approval Request"
								message : "Your request has been rejected."
							)
						}
						actions 
						{
						update closure_review[ID == input.ID]
						[
							review_status = "Rejected"
						]
						}
					}
				}
				on level 2
				{
					approvers
					(
			 			role = "System Administrator"
					)
					on approve 
					{
		    			display name = "Final Approve"
						actions 
						{
							sendmail
							(
								from : zoho.loginuserid
								to : approver.submitter
								subject : "Approval Request"
								message : "Your request has been approved."
							)
						}
						actions 
						{
						update closure_review[ID == input.ID]
						[
							review_status = "Approved"
						]
						}
						actions 
						{
						on load
						(
							if(input.complaint_selection != null)
												{
													complaint_id = input.complaint_selection.toLong();
													// Update complaint status
													update complaint[ID == complaint_id]
													[
														status="Closed"
													];
													// Add activity log
													insert into complaint_activity_log
													[
														complaint=complaint_id
														previous_status="Under Review"
														new_status="Closed"
														action_performed="Final Closure Approved"
														remarks="Closure request approved by Department Head and System Administrator."
														changed_by=zoho.loginuser
														activity_date_time=zoho.currenttime
														Added_User=zoho.loginuser
													]
												}
						)
						}
					}
					on reject
					{

						actions 
						{
							sendmail
							(
								from : zoho.loginuserid
								to : approver.submitter
								subject : "Approval Request"
								message : "Your request has been rejected."
							)
						}
						actions 
						{
						update closure_review[ID == input.ID]
						[
							review_status = "Rejected"
						]
						}
					}
				}
			}
		}

		blueprint
