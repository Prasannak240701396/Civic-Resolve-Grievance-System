			Log_Complaint_Submission2 as "Log Complaint Submission"
			{
				type =  form
				form = complaint

				record event = on add

				on success
				{
					actions 
					{
						custom deluge script
						(
											activityID = insert into complaint_activity_log
										[
											complaint=input.ID
											previous_status="Initial"
											new_status=input.status
											action_performed="Complaint Submitted"
											activity_date_time=zoho.currenttime
											Added_User=zoho.loginuser
										];
										info activityID;
										info "Complaint Submission Workflow Executed Successfully";
						)
					}
				}

			}
			Log_Status_Changes2 as "Log Status Changes"
			{
				type =  form
				form = complaint

				record event = on edit

				on success
				{
					actions 
					{
						custom deluge script
						(
											// Get previous activity records
										logs = complaint_activity_log[complaint == input.ID];
										latestLogID = 0;
										previousStatus = "Initial";
										previousOfficer = null;
										previousDepartment = null;
										for each  logRecord in logs
										{
											if(logRecord.ID > latestLogID)
											{
												latestLogID = logRecord.ID;
												previousStatus = logRecord.new_status;
												previousOfficer = logRecord.new_officer;
												previousDepartment = logRecord.new_department;
											}
										}
										// Identify the type of update
										actionName = "Complaint Details Updated";
										if(input.status != previousStatus)
										{
											actionName = "Status Changed";
										}
										// Save complete complaint history
										insert into complaint_activity_log
										[
											complaint=input.ID
											previous_status=previousStatus
											new_status=input.status
											previous_officer=previousOfficer
											new_officer=input.assigned_officer
											previous_department=previousDepartment
											new_department=input.department
											action_performed=actionName
											changed_by=zoho.loginuser
											activity_date_time=zoho.currenttime
											Added_User=zoho.loginuser
										]
						)
					}
				}

			}
			Notify_Officer_on_Status_ as "Notify Officer on Status Change"
			{
				type =  form
				form = complaint

				record event = on edit

				on success
				{
					actions 
					{
						custom deluge script
						(
											if(input.assigned_officer != null)
										{
											assigned = officer[ID == input.assigned_officer];
											if(assigned.count() > 0 && assigned.email != null && assigned.email != "")
											{
												sendmail
												[
													from :zoho.adminuserid
													to :assigned.email
													subject :"Complaint Status Update"
													message :"Complaint ID: " + input.ID + "\nCurrent Status: " + input.status
												]
											}
										}
						)
					}
				}

			}
			Auto_Assign_Officer_Befor as "Auto Assign Officer Before Validation"
			{
				type =  form
				form = complaint

				record event = on add

				on validate
				{
					actions 
					{
						custom deluge script
						(
											if(input.department != null)
										{
											for each  deptId in input.department
											{
												dept = department[ID == deptId];
												if(dept.count() > 0 && dept.department_head != null)
												{
													for each  officerId in dept.department_head
													{
														head = officer[ID == officerId];
														if(head.count() > 0 && head.active_status == "Active")
														{
															input.assigned_officer = head.ID;
															break;
														}
													}
												}
												if(input.assigned_officer != null)
												{
													break;
												}
											}
										}
						)
					}
				}

			}
