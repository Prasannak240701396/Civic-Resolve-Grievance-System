			Welcome_Citizen as "Welcome Citizen"
			{
				type =  form
				form = citizen

				record event = on add

				on success
				{
					actions 
					{
						custom deluge script
						(
											sendmail
										[
											from :zoho.adminuserid
											to :input.email
											subject :"Welcome to Civic Resolve - Citizen Grievance Management"
											message :"Dear Citizen,\n\nWelcome to Civic Resolve!\n\nCivic Resolve is a citizen grievance management platform designed to make complaint submission, tracking, and resolution more transparent and organized.\n\nThrough this platform, you can submit grievances, track complaint progress, receive status updates, and provide feedback after resolution. Complaints can be routed to the appropriate departments and officers, while evidence verification and closure review support a more accountable resolution process.\n\nOur goal is to make grievance handling easier for citizens and help departments manage complaints systematically.\n\nThank you for joining Civic Resolve. Your voice matters, and we appreciate your trust in our platform.\n\nWarm regards,\nCivic Resolve Team"
										]
						)
					}
				}

			}
			Prevent_Duplicate_Registr as "Prevent Duplicate Registration"
