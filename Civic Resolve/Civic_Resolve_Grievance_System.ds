				height = 13px
	 			row = 1
	 			column = 1   
				width = medium
			)
			review_remarks
			(
    			type = textarea
				displayname = "Review Remarks"
				height = 100px
	 			row = 1
	 			column = 1   
				width = medium
			)
			review_date
			(
    			type = date
				displayname = "Review Date"
				alloweddays = 0,1,2,3,4,5,6
	 			row = 1
	 			column = 1   
				width = medium
			)
			created_date
			(
    			type = date
				displayname = "Created Date"
				alloweddays = 0,1,2,3,4,5,6
	 			row = 1
	 			column = 1   
				width = medium
			)
			Active_Status_Prediction
			(
    			type = text
				displayname = "Active Status Prediction"
	 			row = 1
	 			column = 1   
				width = medium
						AI_Properties
						(
									fieldtype = Prediction
									modelname = "Model_2"
									supportingfield = {created_date,review_status}
						)
			)
	
			actions
			{
				on add
				{
					submit
					(
   						type = submit
   						displayname = "Submit"
					)
					reset
					(
   						type = reset
   						displayname = "Reset"
					)
				}
				on edit
				{
					update
					(
   						type = submit
   						displayname = "Update"
					)
					cancel
					(
   						type = cancel
   						displayname = "Cancel"
					)
				}
			}
			blueprint components
			{
				stages = {"Pending","Approved","Rejected"}
			}
		}
