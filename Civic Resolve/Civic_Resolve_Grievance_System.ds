		 functions
		 {
			 Deluge
			 {
				 string Analyze_Feedback_Rating(int Minimum_Rating)
                 {
                 	if(Minimum_Rating < 1 || Minimum_Rating > 5)
                 	{
                 		return "ERROR: Please enter a rating between 1 and 5.";
                 	}
                 	totalFeedback = 0;
                 	ratingTotal = 0;
                 	result = "========================================\n";
                 	result = result + "          CIVIC RESOLVE\n";
                 	result = result + "    CITIZEN FEEDBACK ANALYSIS\n";
                 	result = result + "========================================\n\n";
                 	result = result + "REPORT SUMMARY\n";
                 	result = result + "----------------------------------------\n";
                 	result = result + "Minimum Rating : " + Minimum_Rating + " / 5\n";
                 	result = result + "Generated On   : " + zoho.currenttime + "\n\n";
                 	feedbackRecords = citizen_feedback[rating != null];
                 	feedbackDetails = "";
                 	for each  rec in feedbackRecords
                 	{
                 		if(rec.rating >= Minimum_Rating)
                 		{
                 			totalFeedback = totalFeedback + 1;
                 			ratingTotal = ratingTotal + rec.rating;
                 			comments = "No comments provided";
                 			if(rec.feedback_comments != null && rec.feedback_comments != "")
                 			{
                 				comments = rec.feedback_comments;
                 			}
                 			feedbackDetails = feedbackDetails + "----------------------------------------\n" + "FEEDBACK #" + totalFeedback + "\n" + "----------------------------------------\n" + "Feedback ID : " + rec.ID + "\n" + "Rating      : " + rec.rating + " / 5\n" + "Status      : " + rec.feedback_status + "\n" + "Comments    : " + comments + "\n\n";
                 		}
                 	}
                 	result = result + "MATCHING FEEDBACK DETAILS\n";
                 	result = result + "========================================\n\n";
                 	if(totalFeedback == 0)
                 	{
                 		result = result + "No feedback found for the selected rating.\n";
                 	}
                 	else
                 	{
                 		result = result + feedbackDetails;
                 	}
                 	averageRating = 0;
                 	if(totalFeedback > 0)
                 	{
                 		averageRating = ratingTotal / totalFeedback;
                 	}
                 	result = result + "========================================\n";
                 	result = result + "FINAL FEEDBACK SUMMARY\n";
                 	result = result + "========================================\n";
                 	result = result + "Matching Feedback : " + totalFeedback + "\n";
                 	result = result + "Average Rating    : " + averageRating + " / 5\n";
                 	result = result + "Minimum Rating    : " + Minimum_Rating + " / 5\n";
                 	result = result + "========================================\n";
                 	result = result + "Generated by Civic Resolve System";
                 	return result;
                 }
				 string Analyze_Officer_Workload(int Minimum_Complaints)
                 {
                 	if(Minimum_Complaints <= 0)
                 	{
                 		return "ERROR: Please enter a number greater than 0.";
                 	}
                 	totalOfficers = 0;
                 	result = "========================================\n";
                 	result = result + "          CIVIC RESOLVE\n";
                 	result = result + "       OFFICER WORKLOAD REPORT\n";
                 	result = result + "========================================\n\n";
                 	result = result + "REPORT SUMMARY\n";
                 	result = result + "----------------------------------------\n";
                 	result = result + "Minimum Complaints : " + Minimum_Complaints + "\n";
                 	result = result + "Generated On      : " + zoho.currenttime + "\n\n";
                 	officerDetails = "";
                 	allOfficers = officer[ID != 0];
                 	for each  officerRec in allOfficers
                 	{
                 		assignedCount = 0;
                 		pendingCount = 0;
                 		inProgressCount = 0;
                 		reopenedCount = 0;
                 		escalatedCount = 0;
                 		assignedComplaints = complaint[assigned_officer == officerRec.ID && status != "Closed" && status != "Resolved"];
                 		for each  comp in assignedComplaints
                 		{
                 			assignedCount = assignedCount + 1;
                 			if(comp.status == "Submitted" || comp.status == "Assigned" || comp.status == "Under Review")
                 			{
                 				pendingCount = pendingCount + 1;
                 			}
                 			else if(comp.status == "In Progress")
                 			{
                 				inProgressCount = inProgressCount + 1;
                 			}
                 			else if(comp.status == "Reopened")
                 			{
                 				reopenedCount = reopenedCount + 1;
                 			}
                 			else if(comp.status == "Escalated")
                 			{
                 				escalatedCount = escalatedCount + 1;
                 			}
                 		}
                 		if(assignedCount >= Minimum_Complaints)
                 		{
                 			totalOfficers = totalOfficers + 1;
                 			officerDetails = officerDetails + "----------------------------------------\n" + "OFFICER #" + totalOfficers + "\n" + "----------------------------------------\n" + "Officer ID          : " + officerRec.ID + "\n" + "Officer Email       : " + officerRec.email + "\n" + "Total Active Cases  : " + assignedCount + "\n" + "Pending Cases       : " + pendingCount + "\n" + "In Progress Cases   : " + inProgressCount + "\n" + "Reopened Cases      : " + reopenedCount + "\n" + "Escalated Cases     : " + escalatedCount + "\n\n";
                 		}
                 	}
                 	result = result + "OFFICER DETAILS\n";
                 	result = result + "========================================\n\n";
                 	if(totalOfficers == 0)
                 	{
                 		result = result + "No officers found matching the workload threshold.\n";
                 	}
                 	else
                 	{
                 		result = result + officerDetails;
                 	}
                 	result = result + "========================================\n";
                 	result = result + "FINAL REPORT SUMMARY\n";
                 	result = result + "========================================\n";
                 	result = result + "Officers Matching Criteria : " + totalOfficers + "\n";
                 	result = result + "Minimum Active Cases       : " + Minimum_Complaints + "\n";
                 	result = result + "========================================\n";
                 	result = result + "Generated by Civic Resolve System";
                 	return result;
                 }
				 string Analyze_Overdue_Complaints(int Days_Overdue)
                 {
                 	if(Days_Overdue <= 0)
                 	{
                 		return "ERROR: Please enter a number greater than 0.";
                 	}
                 	overdueCount = 0;
                 	result = "========================================\n";
                 	result = result + "          CIVIC RESOLVE\n";
                 	result = result + "      OVERDUE COMPLAINT REPORT\n";
                 	result = result + "========================================\n\n";
                 	result = result + "REPORT SUMMARY\n";
                 	result = result + "----------------------------------------\n";
                 	result = result + "Minimum Overdue Days : " + Days_Overdue + "\n";
                 	result = result + "Report Generated     : " + zoho.currenttime + "\n\n";
                 	allComplaints = complaint[sla_due_date != null && status != "Closed" && status != "Resolved"];
                 	complaintDetails = "";
                 	for each  rec in allComplaints
                 	{
                 		overdueDays = rec.sla_due_date.toDate().daysBetween(zoho.currentdate);
                 		if(overdueDays >= Days_Overdue)
                 		{
                 			overdueCount = overdueCount + 1;
                 			complaintDetails = complaintDetails + "----------------------------------------\n" + "COMPLAINT #" + overdueCount + "\n" + "----------------------------------------\n" + "Complaint ID   : " + rec.ID + "\n" + "Title          : " + rec.complaint_title + "\n" + "Priority       : " + rec.priority + "\n" + "Status         : " + rec.status + "\n" + "SLA Due Date   : " + rec.sla_due_date + "\n" + "Days Overdue   : " + overdueDays + " days\n\n";
                 		}
                 	}
                 	result = result + "OVERDUE COMPLAINT DETAILS\n";
                 	result = result + "========================================\n\n";
                 	if(overdueCount == 0)
                 	{
                 		result = result + "No overdue complaints found for the selected threshold.\n";
                 	}
                 	else
                 	{
                 		result = result + complaintDetails;
                 	}
                 	result = result + "========================================\n";
                 	result = result + "FINAL REPORT SUMMARY\n";
                 	result = result + "========================================\n";
                 	result = result + "Total Matching Complaints : " + overdueCount + "\n";
                 	result = result + "Minimum Overdue Threshold : " + Days_Overdue + " days\n";
                 	result = result + "========================================\n";
                 	result = result + "Generated by Civic Resolve System";
                 	return result;
                 }
				 string Check_Complaint_Officer_Assignment(string Complaint_Title)
                 {
                 	matches = complaint[complaint_title == Complaint_Title];
                 	if(matches.count() == 0)
                 	{
                 		return "COMPLAINT NOT FOUND";
                 	}
                 	else if(matches.count() > 1)
                 	{
                 		return "MULTIPLE COMPLAINTS FOUND. USE A UNIQUE TITLE.";
                 	}
                 	else
                 	{
                 		if(matches.assigned_officer == null)
                 		{
                 			return "OFFICER NOT ASSIGNED";
                 		}
                 		else
                 		{
                 			return "OFFICER ASSIGNED";
                 		}
                 	}
                 }
				 string Check_Complaint_SLA_Status(string Complaint_Title)
                 {
                 	matches = complaint[complaint_title == Complaint_Title];
                 	if(matches.count() == 0)
                 	{
                 		return "Complaint Not Found";
                 	}
                 	else if(matches.count() > 1)
                 	{
                 		return "Multiple Complaints Found. Use a Unique Title.";
                 	}
                 	else
                 	{
                 		if(matches.sla_due_date == null)
                 		{
                 			return "SLA Due Date Not Available";
                 		}
                 		else if(matches.sla_due_date < zoho.currenttime)
                 		{
                 			return "OVERDUE";
                 		}
                 		else
                 		{
                 			return "ON TIME";
                 		}
                 	}
                 }
				 string Check_Department_Readiness(string Department_Name)
                 {
                 	dept = department[department_name == Department_Name];
                 	if(dept.count() == 0)
                 	{
                 		return "DEPARTMENT NOT FOUND";
                 	}
                 	else if(dept.count() > 1)
                 	{
                 		return "MULTIPLE DEPARTMENTS FOUND";
                 	}
                 	else if(dept.active_status != "Active")
                 	{
                 		return "DEPARTMENT INACTIVE";
                 	}
                 	else if(dept.department_head == null)
                 	{
                 		return "DEPARTMENT HEAD NOT ASSIGNED";
                 	}
                 	else
                 	{
                 		head = officer[ID == dept.department_head];
                 		if(head.count() == 0)
                 		{
                 			return "DEPARTMENT HEAD RECORD NOT FOUND";
                 		}
                 		else if(head.active_status != "Active")
                 		{
                 			return "NO ACTIVE DEPARTMENT HEAD";
                 		}
                 		else
                 		{
                 			return "DEPARTMENT READY";
                 		}
                 	}
                 }
			 }
		 }


		workflow
		{
		form
		{
			Department_Status_Validat as "Department Status Validation"
			{
				type =  form
				form = department

				record event = on add or edit

