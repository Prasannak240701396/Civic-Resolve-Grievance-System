			Set_Submission_Date_and_C as "Set Submission Date and Calculate SLA Deadline"
			{
				type =  form
				form = complaint

				record event = on add or edit

				on validate
				{
					actions 
					{
						custom deluge script
						(
											// Automatically set submission date and time
										if(input.submission_date_time == null)
										{
											input.submission_date_time = zoho.currenttime;
										}
										// Automatically calculate SLA due date if not entered
										if(input.sla_due_date == null)
										{
											input.sla_due_date = input.submission_date_time.addDay(1);
										}
						)
					}
				}

			}
			Process_Closure_Review as "Process Closure Review"
			{
				type =  form
				form = closure_review

				record event = on add or edit

				on success
				{
					actions 
					{
						custom deluge script
						(
											if(input.complaint_selection != null)
										{
											complaint_id = input.complaint_selection.toLong();
											if(input.review_status == "Approved")
											{
												try 
												{
													// Move the Blueprint stage to "Closed"
													thisapp.blueprint.changeStage("complaint","complaint_lifecycle_management","Closed",complaint_id);
												}		catch (e)
												{
													// Fallback direct update if Blueprint is inactive
													update complaint[ID == complaint_id]
													[
														status="Closed"
													];
												}
											}
											else if(input.review_status == "Rejected")
											{
												try 
												{
													// Move the Blueprint stage to "Under Review"
													thisapp.blueprint.changeStage("complaint","complaint_lifecycle_management","Under Review",complaint_id);
												}		catch (e)
												{
													// Fallback direct update if Blueprint is inactive
													update complaint[ID == complaint_id]
													[
														status="Under Review"
													];
												}
											}
										}
						)
					}
				}

			}
			Notify_Closure_Decision as "Notify Closure Decision"
			{
				type =  form
				form = closure_review

				record event = on add or edit

				on success
				{
					actions 
					{
						custom deluge script
						(
											sendmail
										[
											from :zoho.adminuserid
											to :"prasanna.k.2024.cse@rajalakshmi.edu.in"
											subject :"Civic Resolve - Closure Review Decision | " + input.ID
											message :"Dear Reviewer,\n\n" + "A closure review decision has been recorded in Civic Resolve.\n\n" + "==================================================\n" + "             CLOSURE REVIEW DETAILS\n" + "==================================================\n\n" + "Review Record ID: " + input.ID + "\n" + "Related Complaint: " + input.complaint_selection + "\n" + "Review Status: " + input.review_status + "\n" + "Review Reason: " + input.review_reason + "\n" + "Review Remarks: " + input.review_remarks + "\n\n" + "==================================================\n" + "                 NEXT ACTION\n" + "==================================================\n\n" + "Please review the decision and ensure the appropriate follow-up is completed. An approved review should result in complaint closure, while a rejected review may require further action.\n\n" + "This is an automated notification from Civic Resolve.\n\n" + "Regards,\n" + "Civic Resolve Team\n" + "Citizen Grievance Management System"
										]
						)
					}
				}

			}
			Validate_Activity_Log as "Validate Activity Log"
			{
				type =  form
				form = complaint_activity_log

				record event = on add or edit

