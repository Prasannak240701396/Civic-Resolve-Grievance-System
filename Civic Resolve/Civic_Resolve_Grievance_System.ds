		form Government_Notices_and_Letters
		{
			displayname = "Government Notices and Letters"
			success message = "Data Added Successfully!"
			Section
			(
				type = section
	 			row = 1
	 			column = 0   
				width = medium
			)
			Image
			(
    			type = image
				source  = file
				aspect ratio = original
				camera = primary
				show gallery = true
				switch camera = true
	 			row = 1
	 			column = 1   
				width = medium
			)
			Issuing_Authority
			(
    			type = text
				displayname = "Issuing Authority"
	 			row = 1
	 			column = 1   
				width = medium
						AI_Properties
						(
									fieldtype = OCR
									modelname = "Government_Notice_OCR"
									basefield = Image
									taggedfield = "Issuing Authority"
						)
			)
			Notice_Content
			(
    			type = textarea
				displayname = "Notice Content"
				height = 100px
	 			row = 1
	 			column = 1   
				width = medium
						AI_Properties
						(
									fieldtype = OCR
									modelname = "Government_Notice_OCR"
									basefield = Image
									taggedfield = "Notice Content"
						)
			)
			Notice_Number
			(
    			type = text
				displayname = "Notice Number"
	 			row = 1
	 			column = 1   
				width = medium
						AI_Properties
						(
									fieldtype = OCR
									modelname = "Government_Notice_OCR"
									basefield = Image
									taggedfield = "Notice Number"
						)
			)
	
			actions
			{
				on add
				{
					submit
					(
   						type = submit
   						displayname = "Submit"
					)
				}
				on edit
				{
					update
					(
   						type = submit
   						displayname = "Update"
					)
					cancel
					(
   						type = cancel
   						displayname = "Cancel"
					)
				}
			}
		}
		form officer
		{
